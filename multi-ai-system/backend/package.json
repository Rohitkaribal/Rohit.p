{
  "name": "multi-ai-backend",
  "version": "1.0.0",
  "description": "Multi-AI System Backend - Rohit's All-in-One AI System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node ./node_modules/.bin/knex migrate:latest",
    "migrate:make": "ts-node ./node_modules/.bin/knex migrate:make",
    "migrate:rollback": "ts-node ./node_modules/.bin/knex migrate:rollback"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "drizzle-orm": "^0.29.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
