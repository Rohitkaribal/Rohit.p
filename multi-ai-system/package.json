{
  "name": "multi-ai-system",
  "version": "1.0.0",
  "description": "Rohit's Multi-AI System - All-in-One, All-Rounder AI System with 105 agents, 40 skills, 3-stage pipeline, and limitless improvement",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "migrate": "cd backend && npm run migrate",
    "test": "echo \"Run tests in backend and frontend separately\"",
    "clean": "rm -rf backend/dist backend/node_modules frontend/dist frontend/node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "multi-ai",
    "all-in-one",
    "all-rounder",
    "omega",
    "omni-holistic",
    "supreme",
    "master-ai",
    "agent-system",
    "3-stage-pipeline",
    "fusion-persona",
    "limitless-improvement"
  ],
  "author": "Rohit",
  "license": "Private"
}
